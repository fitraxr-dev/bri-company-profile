# Production Environment Variables Template
# Copy this file to .env and fill in the values

# ========================================
# Server Configuration
# ========================================
PORT=5000

# Logging level: trace, debug, info, warn, error
# Production: warn or error
# Development: info or debug
RUST_LOG=warn

# ========================================
# MongoDB Configuration
# ========================================
# Production MongoDB URI (Atlas recommended)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/production_db?retryWrites=true&w=majority

# ========================================
# JWT Configuration
# ========================================
# Generate secure secret with: openssl rand -hex 64
# MUST be at least 32 characters, 64+ recommended for production
JWT_SECRET=your-production-jwt-secret-key-here-minimum-64-characters-use-openssl-rand-hex-64

# Token expiration in seconds
# 604800 = 7 days
# 86400 = 1 day
# 3600 = 1 hour
JWT_EXPIRES_IN=604800

# ========================================
# Bcrypt Configuration
# ========================================
# Cost factor for password hashing
# Development: 10
# Production: 12 (more secure but slower)
BCRYPT_COST=12

# ========================================
# CORS Configuration
# ========================================
# Comma-separated list of allowed origins
# Production: only your domains
# Development: localhost addresses
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ========================================
# Optional: Rate Limiting (future feature)
# ========================================
# MAX_REQUESTS_PER_MINUTE=100
# MAX_REQUESTS_PER_HOUR=1000

# ========================================
# Optional: Redis (for caching - future feature)
# ========================================
# REDIS_URL=redis://localhost:6379

# ========================================
# Notes:
# ========================================
# 1. NEVER commit this file to version control
# 2. Use different values for dev/staging/production
# 3. Rotate JWT_SECRET regularly (every 6 months)
# 4. Keep backup of production .env file securely
# 5. Use environment-specific files: .env.dev, .env.prod
